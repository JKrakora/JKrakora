[configuration]
entry_symbol = "noise4d_library_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]
macos.debug = "res://addons/noise4d/bin/libnoise4d.macos.template_debug.framework"
macos.release = "res://addons/noise4d/bin/libnoise4d.macos.template_release.framework"
windows.debug.x86_64 = "res://addons/noise4d/bin/libnoise4d.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/noise4d/bin/libnoise4d.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/noise4d/bin/libnoise4d.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/noise4d/bin/libnoise4d.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/noise4d/bin/libnoise4d.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/noise4d/bin/libnoise4d.linux.template_release.arm64.so"
